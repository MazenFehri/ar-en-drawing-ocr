# The API key. Also accepted under NVIDIA_API_KEY or LLM_API_KEY — any OpenAI-compatible
# provider works, since the client is the OpenAI SDK pointed at LLM_BASE_URL.
OPENROUTER_API_KEY=your-openrouter-key-here
# OpenAI-compatible endpoint. OpenRouter by default; for NVIDIA's hosted models use
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Must be a currently-valid vision-capable model ID. OpenRouter rotates its free
# models — see https://openrouter.ai/models?modality=text%2Bimage&max_price=0
#
# "Vision-capable" is not the same as "multimodal-sounding". Verified against NVIDIA's
# endpoint, all with a real 2-crop payload:
#   nvidia/llama-3.1-nemotron-nano-vl-8b-v1   works, ~8.6s for 2 crops
#   nvidia/nemotron-3-nano-omni-30b-a3b-...   text replies in 0.5s, hangs forever on images
#   meta/llama-3.2-11b-vision-instruct        400: "At most 1 image(s) may be provided"
#   meta/llama-3.2-90b-vision-instruct        no response inside 75s
# That one-image cap is fatal here: this pipeline batches up to MAX_CROPS_PER_CALL crops
# per request. Test a candidate before configuring it — `python tools/eval.py --llm` will
# say `failed/timed_out` rather than anything more specific.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Tried in order if OPENROUTER_MODEL is rate-limited, retired or rejects the request.
# Leave EMPTY when not on OpenRouter — these IDs do not exist on other providers, so every
# call would burn its retries on guaranteed 404s before giving up.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
CONFIDENCE_THRESHOLD=0.75
LABEL_SHAPES=true
# Extra context in a flagged word's correction prompt. Both default false, both for the same
# measured reason: added context helps 27B/70B vision models and makes 8B-class ones worse,
# and the free models above sit in the smaller tier. Turn either on only after measuring it
# for your model with `python tools/eval.py --llm`.
#   SHAPE_CONTEXT_ENABLED    confident text from the same detected box (drawings)
#   SENTENCE_CONTEXT_ENABLED the confident lines either side, in reading order (prose)
SHAPE_CONTEXT_ENABLED=false
SENTENCE_CONTEXT_ENABLED=false
DATABASE_URL=postgresql://ocr:ocr@localhost:5432/ocr_db
LOG_LEVEL=INFO
