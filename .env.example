OPENROUTER_API_KEY=your-openrouter-key-here
# Must be a currently-valid vision-capable model ID. OpenRouter rotates its free
# models — see https://openrouter.ai/models?modality=text%2Bimage&max_price=0
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Tried in order if OPENROUTER_MODEL is rate-limited, retired or rejects the request.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
CONFIDENCE_THRESHOLD=0.75
LABEL_SHAPES=true
DATABASE_URL=postgresql://ocr:ocr@localhost:5432/ocr_db
LOG_LEVEL=INFO
